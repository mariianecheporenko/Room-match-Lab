<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RoomMates</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-semibold" asp-controller="HousingsMvc" asp-action="Index">RoomMates</a>
        <div class="navbar-nav flex-row gap-3">
            <a class="nav-link" asp-controller="HousingsMvc" asp-action="Index">Housings</a>
            <a class="nav-link" asp-controller="ProfilesMVC" asp-action="Index">Profiles</a>
            <a class="nav-link" asp-controller="BookingRequestsMVC" asp-action="Index">Bookings</a>
        </div>
    </div>
</nav>
<main class="container py-5">
    @RenderBody()
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
