@model Housing
@{
    ViewData["Title"] = "Create housing";
}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h2">Create housing</h1>
                    <p class="text-secondary">Add the listing details below.</p>
                    <form asp-action="Create" enctype="multipart/form-data" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        <div class="row g-3">
                            <div class="col-12 mb-3">
                                <label class="form-label">Завантажити фото житла</label>
                                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                            </div>
                            <div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
                            <div class="col-md-4"><label asp-for="PricePerMonth" class="form-label"></label><input asp-for="PricePerMonth" class="form-control" /><span asp-validation-for="PricePerMonth" class="text-danger"></span></div>
                            <div class="col-md-6"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="text-danger"></span></div>
                            <div class="col-md-6"><label asp-for="District" class="form-label"></label><input asp-for="District" class="form-control" /></div>
                            <div class="col-md-8"><label asp-for="Street" class="form-label"></label><input asp-for="Street" class="form-control" /><span asp-validation-for="Street" class="text-danger"></span></div>
                            <div class="col-md-4"><label asp-for="BuildingNumber" class="form-label"></label><input asp-for="BuildingNumber" class="form-control" /><span asp-validation-for="BuildingNumber" class="text-danger"></span></div>
                            <div class="col-md-6"><label asp-for="ApartmentNumber" class="form-label"></label><input asp-for="ApartmentNumber" class="form-control" /></div>
                            <div class="col-md-3"><label asp-for="Latitude" class="form-label"></label><input asp-for="Latitude" class="form-control" /></div>
                            <div class="col-md-3"><label asp-for="Longitude" class="form-label"></label><input asp-for="Longitude" class="form-control" /></div>
                        </div>
                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Create housing</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Back to listings</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
