@model Housing
@{
    ViewData["Title"] = Model.Title;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Title - RoomMates</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-semibold" asp-controller="HousingsMvc" asp-action="Index">RoomMates</a>
        <div class="navbar-nav flex-row gap-3">
            <a class="nav-link active" asp-controller="HousingsMvc" asp-action="Index">Housings</a>
            <a class="nav-link" asp-controller="ProfilesMVC" asp-action="Index">Profiles</a>
            <a class="nav-link" asp-controller="BookingRequestsMVC" asp-action="Index">Bookings</a>
        </div>
    </div>
</nav>
<main class="container py-5">
    <a asp-action="Index" class="text-decoration-none">&larr; All listings</a>
    <article class="card shadow-sm mt-3">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-wrap justify-content-between gap-3 mb-4">
                <div><h1 class="h2 mb-1">@Model.Title</h1><p class="text-secondary mb-0">@Model.City@(string.IsNullOrWhiteSpace(Model.District) ? "" : $", {Model.District}")</p></div>
                <div class="fs-4 fw-semibold text-primary">@Model.PricePerMonth.ToString("C") <span class="fs-6 text-secondary">/ month</span></div>
            </div>
            <dl class="row mb-0">
                <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Street @Model.BuildingNumber@(string.IsNullOrWhiteSpace(Model.ApartmentNumber) ? "" : $", apt. {Model.ApartmentNumber}")</dd>
                <dt class="col-sm-3">Pets</dt><dd class="col-sm-9">@Model.PetPolicy</dd>
                <dt class="col-sm-3">Smoking</dt><dd class="col-sm-9">@(Model.AllowsSmoking ? "Allowed" : "Not allowed")</dd>
            </dl>
        </div>
    </article>
</main>
</body>
</html>
