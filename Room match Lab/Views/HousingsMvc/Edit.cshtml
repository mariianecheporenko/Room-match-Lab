@model RoomMates.Models.Housing
@{
    ViewData["Title"] = "Edit housing";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit housing - RoomMates</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-semibold" asp-controller="HousingsMvc" asp-action="Index">RoomMates</a>
        <div class="navbar-nav flex-row gap-3">
            <a class="nav-link active" asp-controller="HousingsMvc" asp-action="Index">Housings</a>
            <a class="nav-link" asp-controller="ProfilesMVC" asp-action="Index">Profiles</a>
            <a class="nav-link" asp-controller="BookingRequestsMVC" asp-action="Index">Bookings</a>
        </div>
    </div>
</nav>
<main class="container py-5"><div class="row justify-content-center"><div class="col-lg-8">
    <div class="card shadow-sm"><div class="card-body p-4">
        <h1 class="h2">Edit housing</h1><p class="text-secondary">Update the listing details.</p>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="PricePerMonth" class="form-label"></label><input asp-for="PricePerMonth" class="form-control" /><span asp-validation-for="PricePerMonth" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="District" class="form-label"></label><input asp-for="District" class="form-control" /></div>
                <div class="col-md-8"><label asp-for="Street" class="form-label"></label><input asp-for="Street" class="form-control" /><span asp-validation-for="Street" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="BuildingNumber" class="form-label"></label><input asp-for="BuildingNumber" class="form-control" /><span asp-validation-for="BuildingNumber" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="ApartmentNumber" class="form-label"></label><input asp-for="ApartmentNumber" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Latitude" class="form-label"></label><input asp-for="Latitude" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Longitude" class="form-label"></label><input asp-for="Longitude" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="PetPolicy" class="form-label"></label><select asp-for="PetPolicy" asp-items="Html.GetEnumSelectList<RoomMates.Models.PetPolicy>()" class="form-select"></select></div>
                <div class="col-md-4"><label asp-for="RequiredCleanliness" class="form-label"></label><input asp-for="RequiredCleanliness" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="RequiredSleepSchedule" class="form-label"></label><input asp-for="RequiredSleepSchedule" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="RequiredPartyTolerance" class="form-label"></label><input asp-for="RequiredPartyTolerance" class="form-control" /></div>
                <div class="col-md-6 form-check ms-2"><input asp-for="HasExistingPets" class="form-check-input" /><label asp-for="HasExistingPets" class="form-check-label"></label></div>
                <div class="col-md-6 form-check ms-2"><input asp-for="AllowsSmoking" class="form-check-input" /><label asp-for="AllowsSmoking" class="form-check-label"></label></div>
            </div>
            <div class="mt-4 d-flex gap-2"><button type="submit" class="btn btn-primary">Save changes</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
        </form>
    </div></div>
</div></div></main>
</body>
</html>
