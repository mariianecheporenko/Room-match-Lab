@model IEnumerable<Housing>
@{
    ViewData["Title"] = "Available housings";
}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Available housings</h1>
            <p class="text-secondary mb-0">Browse current room listings.</p>
        </div>
        <a class="btn btn-primary" asp-controller="HousingsMvc" asp-action="Create">Create New</a>
    </div>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr><th>Title</th><th>Price</th><th>City</th><th>District</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No housing listings yet.</td></tr>
                }
                @foreach (var housing in Model)
                {
                    <tr>
                        <td class="fw-semibold">@housing.Title</td>
                        <td>@housing.PricePerMonth.ToString("C")</td>
                        <td>@housing.City</td>
                        <td>@(housing.District ?? "—")</td>
                        <td class="text-end text-nowrap">
                                    <!-- <a class="btn btn-sm btn-outline-primary" asp-controller="HousingsMvc" asp-action="Details" asp-route-id="@housing.Id">Open Landing Page</a> -->
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="HousingsMvc" asp-action="Edit" asp-route-id="@housing.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-controller="HousingsMvc" asp-action="Delete" asp-route-id="@housing.Id">Delete</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
