@model RoomMates.Models.Profile

@{
    ViewData["Title"] = "Edit";
    var availableTags = ViewBag.AvailableTags as IEnumerable<RoomMates.Models.Tag> ?? [];
    var selectedTagIds = Model.ProfileTags.Select(link => link.TagId).ToHashSet();
}

<h1>Edit</h1>

<h4>Profile</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="FullName" class="control-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AvatarUrl" class="control-label"></label>
                <input asp-for="AvatarUrl" class="form-control" />
                <span asp-validation-for="AvatarUrl" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Budget" class="control-label"></label>
                <input asp-for="Budget" class="form-control" />
                <span asp-validation-for="Budget" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PetTolerance" class="control-label"></label>
                <input asp-for="PetTolerance" class="form-control" />
                <span asp-validation-for="PetTolerance" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OwnPets" class="control-label"></label>
                <input asp-for="OwnPets" class="form-check-input" />
                <span asp-validation-for="OwnPets" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsSmoker" class="control-label"></label>
                <input asp-for="IsSmoker" class="form-check-input" />
                <span asp-validation-for="IsSmoker" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cleanliness" class="control-label"></label>
                <input asp-for="Cleanliness" type="number" min="1" max="5" step="1" class="form-control rating-scale" />
                <span asp-validation-for="Cleanliness" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SleepSchedule" class="control-label"></label>
                <input asp-for="SleepSchedule" type="number" min="1" max="5" step="1" class="form-control rating-scale" />
                <span asp-validation-for="SleepSchedule" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PartyTolerance" class="control-label"></label>
                <input asp-for="PartyTolerance" type="number" min="1" max="5" step="1" class="form-control rating-scale" />
                <span asp-validation-for="PartyTolerance" class="text-danger"></span>
            </div>
            <div class="form-group mt-3" id="profile-tags">
                <fieldset>
                    <legend class="control-label">Interests (choose up to 5)</legend>
                    @foreach (var tag in availableTags)
                    {
                        <label class="form-check">
                            <input class="form-check-input profile-tag-choice" type="checkbox" name="tagIds" value="@tag.Id" checked="@selectedTagIds.Contains(tag.Id)" />
                            <span class="form-check-label">@tag.Name</span>
                        </label>
                    }
                </fieldset>
                <div id="profile-tag-count" class="form-text" aria-live="polite"></div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (() => {
            const choices = Array.from(document.querySelectorAll(".profile-tag-choice"));
            const countLabel = document.getElementById("profile-tag-count");
            const ratingInputs = Array.from(document.querySelectorAll(".rating-scale"));
            const max = 5;

            function updateChoices() {
                const selectedCount = choices.filter(choice => choice.checked).length;
                choices.forEach(choice => {
                    choice.disabled = !choice.checked && selectedCount >= max;
                });
                countLabel.textContent = `${selectedCount} / ${max} selected`;
            }

            choices.forEach(choice => choice.addEventListener("change", updateChoices));
            updateChoices();

            ratingInputs.forEach(input => input.addEventListener("input", () => {
                const value = Number(input.value);
                if (input.value !== "" && value > max) input.value = String(max);
                if (input.value !== "" && value < 1) input.value = "1";
            }));
        })();
    </script>
}
