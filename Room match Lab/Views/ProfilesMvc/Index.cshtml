@model IEnumerable<RoomMates.Models.Profile>
@{
    ViewData["Title"] = "My profile";
    var currentProfile = Model.FirstOrDefault();
    var landlordApplicationPending = currentProfile?.Role == "Landlord" && currentProfile.IsApproved == false;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h2 mb-1">My profile</h1><p class="text-secondary mb-0">Manage your account details and housing owner access.</p></div>
</div>
@if (TempData["ProfileMessage"] is string message && !landlordApplicationPending)
{
    <div class="alert alert-info">@message</div>
}
<div id="pendingApplicationAlert" class="alert alert-info" role="status" aria-live="polite" style="@(landlordApplicationPending ? "" : "display:none;")">
    Application submitted. An administrator will review it soon.
</div>
<div id="approvedLandlordAlert" class="alert alert-success" role="status" aria-live="polite" style="display:none;">
    Ваш акаунт власника житла успішно підтверджено! Тепер ви можете додавати житло.
</div>
<div class="card shadow-sm border-0"><div class="table-responsive">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark"><tr><th>Name</th><th>Email</th><th>Budget</th><th>Pets</th><th>Smoking</th><th>Role</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-secondary py-5">Profile not found.</td></tr>
        }
        @foreach (var profile in Model)
        {
            <tr data-user-id="@profile.Id" data-user-email="@profile.Email">
                <td class="fw-semibold">@profile.FullName</td><td>@profile.Email</td><td>@profile.Budget.ToString("C")</td>
                <td>@(profile.OwnPets ? "Has pets" : profile.PetTolerance.ToString())</td><td>@(profile.IsSmoker ? "Smoker" : "Non-smoker")</td>
                <td id="userRoleCell" class="user-role-cell">@profile.Role@if (profile.Role == "Landlord" && !profile.IsApproved) { <span> — pending approval</span> }</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@profile.Id">Edit</a>
                    @if (profile.Role == "Student")
                    {
                        <form class="d-inline" asp-action="RequestLandlordStatus" method="post">
                            <button class="btn btn-sm btn-outline-primary" type="submit">Apply to become a housing owner</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div></div>

@section Scripts {
    <script>
        (() => {
            const row = document.querySelector("tr[data-user-id]");
            const pendingAlert = document.getElementById("pendingApplicationAlert");
            const approvedAlert = document.getElementById("approvedLandlordAlert");
            const roleCell = document.getElementById("userRoleCell");
            if (!row) return;

            window.addEventListener("landlordStatusUpdated", event => {
                const update = event.detail;
                const sameUser = (update.email || "").toLowerCase() === (row.dataset.userEmail || "").toLowerCase() ||
                    (update.userId || "").toLowerCase() === (row.dataset.userId || "").toLowerCase();
                if (!sameUser) return;

                if (update.role === "Landlord" && update.isApproved) {
                    pendingAlert.style.display = "none";
                    approvedAlert.style.display = "block";
                    roleCell.textContent = "Landlord";
                } else if (update.role === "Landlord") {
                    pendingAlert.style.display = "block";
                    approvedAlert.style.display = "none";
                    roleCell.textContent = "Landlord — pending approval";
                } else if (update.role === "Student") {
                    pendingAlert.style.display = "none";
                    approvedAlert.style.display = "none";
                    roleCell.textContent = "Student";
                }
            });
        })();
    </script>
}
