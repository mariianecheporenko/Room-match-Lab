@{
    ViewData["Title"] = "Account password";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h2">Account password</h1>
                <p class="text-secondary">Set a password to enable email and password sign-in, or change your existing password.</p>
                <form id="passwordSettingsForm">
                    <div class="mb-3">
                        <label for="currentPassword" class="form-label">Current password (leave blank if you do not have one)</label>
                        <input id="currentPassword" name="currentPassword" type="password" class="form-control" autocomplete="current-password" />
                    </div>
                    <div class="mb-3">
                        <label for="newPassword" class="form-label">New password</label>
                        <input id="newPassword" name="password" type="password" class="form-control" autocomplete="new-password" minlength="8" maxlength="128" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Save password</button>
                </form>
                <div id="passwordSettingsStatus" class="small mt-3" role="status" aria-live="polite"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("passwordSettingsForm").addEventListener("submit", async event => {
            event.preventDefault();
            const status = document.getElementById("passwordSettingsStatus");
            const values = Object.fromEntries(new FormData(event.currentTarget).entries());
            status.textContent = "Saving password…";

            try {
                const response = await window.RoomMatesAuth.fetch("/api/auth/password", {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        currentPassword: values.currentPassword || null,
                        password: values.password
                    })
                });

                if (response.ok) {
                    event.currentTarget.reset();
                    status.textContent = "Password saved. You can now sign in with your email and password.";
                } else if (response.status === 401) {
                    status.textContent = "Current password is incorrect, or your session has expired.";
                } else {
                    status.textContent = "Could not save the password. Check that it has at least 8 characters.";
                }
            } catch {
                status.textContent = "Could not reach the account service. Please try again.";
            }
        });
    </script>
}
